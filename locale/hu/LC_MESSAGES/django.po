msgstr "A tervezőmotor által használt napló / hibakeresési kontextus (csak szűrt adat)."

msgid "Full validated workout proposal (warm-up / main / accessory / cool-down). When set, this is the source of truth."
msgstr "Teljes, érvényesített edzésjavaslat (bemelegítés / főblokk / kiegészítő / levezetés). Ha ki van töltve, ez az igazság forrása."

msgid "Slugs of exercises in the plan in order (used for repetition control and fast counting)."
msgstr "A tervben szereplő gyakorlatok slug-jai sorrendben (ismétlődés és gyors számlálás)."

msgid "Display / execution order within the plan."
msgstr "Megjelenítési / végrehajtási sorrend a terven belül."

msgid "Reps (e.g. “8–12”, “10”, “time:45 s”)."
msgstr "Ismétlések (pl. „8–12”, „10”, „idő:45 mp”)."

msgid "Tempo (e.g. “2-0-2”)."
msgstr "Tempó (pl. „2-0-2”)."

msgid "Subjective difficulty (e.g. 1–10)."
msgstr "Szubjektív nehézség (pl. 1–10)."

msgid "Whether the member reported pain that should adjust the plan."
msgstr "A tag fájdalmat jelzett-e, ami miatt módosítani kell a tervet."

msgid "Optional link to the member's Django user."
msgstr "Opcionális kapcsolat a tag Django-felhasználójához."

msgid "Displayed phone number (member's own account or provided by the coach)."
msgstr "Megjelenített telefonszám (tag saját fiókja vagy edző által megadva)."

msgid "Digits only (for consistent search); empty when no phone is set."
msgstr "Csak számjegyek (egységes kereséshez); üres, ha nincs telefon."

